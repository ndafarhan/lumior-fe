{
  "openapi": "3.1.0",
  "info": {
    "title": "Lumior API",
    "version": "0.1.0",
    "description": "DRAFT contract proposed by lumior-fe (auth-and-households). See contracts/auth-and-households.md. Replace with the backend's published document once it exists."
  },
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "operationId": "auth_register",
        "summary": "Create an account and sign in",
        "tags": ["auth"],
        "security": [],
        "responses": {
          "201": {
            "description": "Account created and signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "Refresh token: HttpOnly; Secure (outside local development); SameSite=Lax; Path=/api/v1/auth.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "`email_taken`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error (`validation_error`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "auth_login",
        "summary": "Sign in",
        "tags": ["auth"],
        "security": [],
        "responses": {
          "200": {
            "description": "Signed in.",
